{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": []
        },
        "extensions": [
          {
            "name": "codeql/javascript-queries",
            "rules": [
              {
                "id": "js/code-injection",
                "defaultConfiguration": {
                  "level": "error"
                },
                "properties": {
                  "tags": ["security"],
                  "security-severity": "9.3"
                }
              }
            ]
          }
        ]
      },
      "results": [
        {
          "rule": {
            "index": 0,
            "toolComponent": {
              "index": 0
            }
          },
          "level": "error",
          "message": {
            "text": "User-controlled data flows into code execution."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app.js"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
